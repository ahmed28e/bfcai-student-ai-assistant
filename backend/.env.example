# ==========================================
# إعدادات المساعد الذكي لكلية الحاسبات والذكاء الاصطناعي - جامعة بنها (BFCAI)
# ==========================================

# المنفذ وبيئة التشغيل
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# مزود نموذج اللغة (LLM Provider: gemini / openai / mock)
LLM_PROVIDER=gemini

# مفاتيح الذكاء الاصطناعي (اختر أحدهما أو استخدم mock للتجربة المحلية بدون مفاتيح)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# اسم النموذج المستخدم
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# إعدادات قاعدة البيانات المتجهة (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=bfcai_knowledge_base
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# إعدادات محرك البحث الحي (Web Search Fallback)
WEB_SEARCH_ENABLED=true
SEARCH_ENGINE=duckduckgo # خيارات: duckduckgo, tavily, google_custom_search
TAVILY_API_KEY=your_tavily_api_key_here
GOOGLE_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_cse_id_here

# روابط المصادر الرسمية المعتمدة للكلية
BFCAI_WEBSITE_URL=https://fci.bu.edu.eg/
BFCAI_FACEBOOK_URL=https://www.facebook.com/Official.BFCAI
BFCAI_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbDCrkm0Qean90DDeQ1Q
